[Unit]
Description=Playwright MCP attached to the independent Chromium browser
PartOf=onepve-agent-session.target
Wants=onepve-agent-chromium.service
After=onepve-agent-chromium.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecCondition=/opt/onepve-agent/bin/agent-mcp-permitted
ExecStart=/opt/onepve-agent/bin/agent-run-mcp
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
