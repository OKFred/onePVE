#!/usr/bin/env bash
set -euo pipefail
source /opt/onepve-agent/bin/common.sh
require_x11

# Configure the dedicated account once; later user changes are retained.
first_setup=false
if [[ ! -f "$STATE_DIR/ibus-configured" ]]; then
  gsettings set org.freedesktop.ibus.general preload-engines "['xkb:us::eng', 'libpinyin']"
  gsettings set org.freedesktop.ibus.general engines-order "['xkb:us::eng', 'libpinyin']"
  gsettings set org.freedesktop.ibus.general.hotkey triggers "['<Control>space']"
  first_setup=true
fi
# im-config normally starts the daemon before XFCE. Do not replace a running
# daemon, which could interrupt current text composition or a manual session.
if ! pgrep -u "$(id -u)" -x ibus-daemon >/dev/null; then
  ibus-daemon --daemonize --xim
fi
if [[ $first_setup == true ]]; then
  for attempt in {1..20}; do
    if ibus engine xkb:us::eng >/dev/null 2>&1; then
      : > "$STATE_DIR/ibus-configured"
      break
    fi
    sleep 0.25
  done
  [[ -f "$STATE_DIR/ibus-configured" ]] || {
    printf 'IBus did not become ready; rerun agent-session-start from XFCE.\n' >&2
    exit 1
  }
fi
